# Capataz Nube. Copia a .env (nunca al repositorio) y genera APP_KEY con
#   php artisan key:generate
# APP_KEY cifra las claves de instancia en la base de datos: si cambia, hay
# que conservar la anterior en APP_PREVIOUS_KEYS o las instancias dejan de
# poder firmar.
APP_NAME="Capataz Nube"
APP_ENV=local
APP_KEY=
APP_PREVIOUS_KEYS=
APP_DEBUG=false
APP_URL=http://127.0.0.1:18090
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

# Bitácora: nunca lleva tokens, claves, cuerpos ni nombres.
LOG_CHANNEL=single
LOG_LEVEL=info

# Desarrollo: SQLite (database/database.sqlite). Producción: mysql con
# DB_HOST, DB_PORT, DB_DATABASE, DB_USERNAME y DB_PASSWORD.
DB_CONNECTION=sqlite

# Sin sesiones ni colas; la caché (límites de peticiones y candado del
# programador) va en la base de datos: el hosting no garantiza redis.
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
CACHE_STORE=database

# Bytes de los paquetes, fuera de public/ (en el hosting,
# ~/domains/sync.softmx.net/capataz-datos). Vacío = storage/app/capataz-datos.
CAPATAZ_DATA_DIR=

# Límites del contrato (GET /v1/instance los publica).
NUBE_MAX_ENCRYPTED_BYTES=524296032
NUBE_MIN_PART_SIZE=1048576
NUBE_MAX_PART_SIZE=8388608
NUBE_MIN_TTL_SECONDS=3600
NUBE_MAX_TTL_SECONDS=2592000
NUBE_MAX_ACTIVE_LINKS=100
NUBE_MAX_STORED_BYTES=5368709120
NUBE_MAX_META_BLOB_BYTES=196608

# Plazos, en segundos salvo que se diga otra cosa.
NUBE_CLOCK_SKEW=300
NUBE_NONCE_TTL=600
NUBE_TTL_TOLERANCE=300
NUBE_EXHAUSTED_GRACE=3600
NUBE_UPLOAD_ABANDON_HOURS=48
NUBE_STREAM_CHUNK=65536

# Peticiones por minuto: API de instancia (por instancia) y descarga
# pública (por IP).
NUBE_RATE_INSTANCE_PER_MINUTE=600
NUBE_RATE_PUBLIC_PER_MINUTE=120

# Proxies de confianza para obtener la IP del cliente: lista separada por
# comas, "*" para todos o vacío para ninguno. Verificar en el hosting real.
NUBE_TRUSTED_PROXIES=
