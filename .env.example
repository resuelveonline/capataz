SYNCTHING_URL=http://127.0.0.1:8384
SYNCTHING_API_KEY=
CAPATAZ_LISTEN=127.0.0.1:8080
# Token temporal de desarrollo (mínimo 32 caracteres). Genera uno con:
#   openssl rand -base64 32
CAPATAZ_DEV_TOKEN=
# Estado de la instancia (instanceId). Fuera del repo y fuera de ~/capataz-dev.
CAPATAZ_STATE_DIR=~/capataz-host/state
# Opcional: nombre público que devuelve GET /instance (por defecto "Capataz").
CAPATAZ_INSTANCE_NAME=
# Fases posteriores (enlaces):
CAPATAZ_STAGING_DIR=
CAPATAZ_PUBLIC_URL=
