SYNCTHING_URL=http://127.0.0.1:8384
SYNCTHING_API_KEY=
CAPATAZ_LISTEN=127.0.0.1:8080
# Token temporal de desarrollo (mínimo 32 caracteres). Genera uno con:
#   openssl rand -base64 32
CAPATAZ_DEV_TOKEN=
# Estado de la instancia (instanceId). Fuera del repo y fuera de ~/capataz-dev.
CAPATAZ_STATE_DIR=~/capataz-host/state
# Opcional: nombre público que devuelve GET /instance (por defecto "Capataz").
CAPATAZ_INSTANCE_NAME=
# Copias congeladas temporales (Fase 2a). Fuera de cualquier carpeta
# sincronizada; se crea con permisos 0700. Vacía = ~/capataz-host/staging.
CAPATAZ_STAGING_DIR=~/capataz-host/staging
# Capataz Nube (Fase 2b, enlaces). Vacía = https://sync.softmx.net; http solo
# en loopback (desarrollo con una nube falsa).
CAPATAZ_NUBE_URL=
# Clave de instancia: 32 bytes en base64url, la que muestra una sola vez
#   php artisan capataz:instance:add <instanceId>
# Vacía = enlaces desactivados (POST /links responde cloud_unreachable).
CAPATAZ_NUBE_KEY=
